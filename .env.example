# Supabase (multiplayer, accounts, schools). Without these the game runs
# fully offline in single-player mode.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only — used to create student logins. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Paystack (in-app purchases). Test keys start with sk_test_/pk_test_.
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Public URL of the site (Paystack redirects back here after checkout).
NEXT_PUBLIC_APP_URL=https://your-domain
